{
  "name": "shirly-portfolio",
  "private": true,
  "description": "Portfolio website of Shirly P. Delankawala. Edit content.js for text; run `npm run build` only after changing files in src/.",
  "scripts": {
    "start": "esbuild --servedir=. --serve=4173",
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=assets/js/app.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=assets/js/app.js --watch",
    "export": "npm run build && node scripts/export.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
